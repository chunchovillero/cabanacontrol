# Dedicated environment. Never use development credentials or commit the real file.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=https://localhost:25443
POSTGRES_DB=cabanacontrol_production
POSTGRES_USER=cabanacontrol_production
POSTGRES_PASSWORD=replace-with-a-dedicated-random-password
POSTGRES_ADMIN_USER=cabanacontrol_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-administrative-password
PRIVATE_MEDIA_ROOT=/var/lib/cabanacontrol/media
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
AI_ENABLED=false
AI_TEST_PROVIDER=false
WHATSAPP_REAL_ENABLED=false
WHATSAPP_TEST_PROVIDER=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ENCRYPTION_KEYS={}
WHATSAPP_ACTIVE_KEY_VERSION=v1
E2E_TEST_MODE=false
# Compose substitutions; TLS files must be server.crt and server.key.
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost:25443
PRODUCTION_HTTP_PORT=25080
PRODUCTION_HTTPS_PORT=25443
TLS_DIRECTORY=./.local-production/tls
