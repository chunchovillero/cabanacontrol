# Desarrollo local únicamente. Reemplazar ambos valores antes de iniciar.
DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=true
# Alta de propietario y primera empresa, solo con DEBUG=true; producción fuerza false.
LOCAL_ONBOARDING_ENABLED=true
BILLING_SIMULATION_ENABLED=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=cabanacontrol
POSTGRES_USER=cabanacontrol
POSTGRES_PASSWORD=replace-with-a-random-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_PROXY_TARGET=http://backend:8000
# Detectar cambios de archivos montados desde Windows en Docker.
VITE_USE_POLLING=true
FRONTEND_URL=http://localhost:5173
# Desarrollo: correos privados dentro del contenedor, nunca en stdout/logs.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=/tmp/cabanacontrol-emails
DEFAULT_FROM_EMAIL=CabañaControl <no-reply@example.invalid>
# Para SMTP real: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
PRIVATE_MEDIA_ROOT=/var/lib/cabanacontrol/media
# IA desactivada por defecto. Modelo y precios se verifican antes de uso real.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=
AI_PRICE_AUDIO_USD_PER_MINUTE=
AI_PRICE_INPUT_USD_PER_MILLION=
AI_PRICE_OUTPUT_USD_PER_MILLION=

# WhatsApp real desactivado. Activación real exige autorización independiente.
WHATSAPP_REAL_ENABLED=false
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# JSON con claves Fernet dedicadas, nunca DJANGO_SECRET_KEY; ejemplo estructura {}.
WHATSAPP_ENCRYPTION_KEYS={}
WHATSAPP_ACTIVE_KEY_VERSION=v1
