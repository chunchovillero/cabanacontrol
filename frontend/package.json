{
  "name": "cabanacontrol-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format:check": "prettier --check src vite.config.ts playwright.config.ts playwright.production.config.ts e2e production-e2e eslint.config.js tsconfig.json components.json package.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config playwright.production.config.ts"
  },
  "dependencies": {
    "@fullcalendar/react": "^7.1.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.2.0",
    "@tanstack/react-query": "^5.104.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.3.0",
    "temporal-polyfill": "^1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
